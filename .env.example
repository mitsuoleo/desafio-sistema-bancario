DB_HOST=seu-host-aqui
DB_NAME=nome_do_banco
DB_USER=usuario
DB_PASSWORD=senha
DB_PORT=5432

# Protótipo web — autenticação (altere em ambientes reais)
PORTAL_SECRET=altere-este-segredo-portal
ADMIN_USUARIO=admin
ADMIN_SENHA=banco1234
ADMIN_TOKEN=altere-este-token-admin

# CORS (origens separadas por vírgula)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# API legada sem autenticação — manter false
ENABLE_LEGACY_API=false
